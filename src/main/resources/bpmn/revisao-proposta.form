{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.40.0"
  },
  "schemaVersion": 16,
  "id": "revisao-proposta",
  "type": "default",
  "components": [
    {
      "id": "Texto_resumo",
      "type": "text",
      "text": "### Revisão de proposta\n\nCliente: **{{cliente}}**  \nValor: **{{valor}}** em **{{parcelas}}** parcelas  \nScore: **{{score}}** · Taxa sugerida: **{{taxaMensal}}% a.m.**"
    },
    {
      "id": "Campo_aprovado",
      "type": "checkbox",
      "key": "aprovadoManualmente",
      "label": "Aprovar proposta",
      "defaultValue": false
    },
    {
      "id": "Campo_parecer",
      "type": "textarea",
      "key": "parecer",
      "label": "Parecer",
      "validate": {
        "required": true
      }
    }
  ]
}
